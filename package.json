{
  "name": "inventory-management",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "start": "pnpm --filter api start:prod",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:migrate:prod": "pnpm --filter api db:migrate:prod",
    "db:push": "pnpm --filter api db:push",
    "db:reset": "pnpm --filter api db:reset",
    "db:studio": "pnpm --filter api db:studio"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
