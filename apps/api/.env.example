DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:redis_secret@localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-minimum-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-minimum-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL="http://192.168.0.6:3001"
# Frontend origin allowed by CORS (scheme + host + port, no trailing slash)
FRONTEND_URL="https://b5gcf0z2-5173.uks1.devtunnels.ms"

# ─── File storage ─────────────────────────────────────────────────────────────
# Where uploaded photos are written. In production, point this at a mounted
# persistent volume (e.g. a Railway volume) — plain container disk is wiped on
# every deploy.
UPLOAD_DIR="./uploads"

# ─── Mail Configuration ───────────────────────────────────────────────────────────────
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="your-mail-user"
MAIL_PASSWORD="your-mail-password"
MAIL_FROM="your-mail-from-address"