generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  admin
  general_management
  supervisor
  merchandiser
}

enum VisitStatus {
  open
  completed
}

enum VisitReportCategory {
  display
  tg
  mea
  plv
}

enum AuditItemStatus {
  in_stock
  stock_disponible
  low_stock
  out_of_stock
}

enum ScheduleStatus {
  pending
  completed
  cancelled
}

/// Distribution channel of a point of sale.
/// gms = Grande et Moyenne Surface (hyper/supermarkets); ls = Libre Service (self-service).
enum StoreChannel {
  gms
  ls
}

/// Commercial importance of a point of sale — A is the highest.
enum StoreClassification {
  A
  B
  C
  D
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum BillingPeriod {
  monthly
  quarterly
  yearly
}

/// Whether a higher or a lower value means better performance for a KPI.
enum KpiDirection {
  higher_is_better
  lower_is_better
}

enum WidgetType {
  kpi_card
  line_chart
  bar_chart
  pie_chart
  table
}

enum NotificationType {
  promo_created
  price_survey_products_assigned
}

/// Whose entry a PriceSurveyNote textarea belongs to.
enum PriceSurveyNoteSide {
  own
  competitor
}

// ─── Models ────────────────────────────────────────────────────────────────────

model Region {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())

  users  User[]
  stores Store[]

  @@map("regions")
}

model User {
  id        String   @id @default(uuid())
  full_name String
  email     String   @unique
  password  String
  /// Legacy coarse role. Kept in sync with `custom_role` and still read by RolesGuard.
  role      UserRole @default(merchandiser)
  /// DB-driven role carrying the actual permission set. Resolved by PermissionsGuard.
  custom_role    Role?    @relation(fields: [role_id], references: [id], onDelete: SetNull)
  role_id        String?
  is_active      Boolean  @default(true)
  deactivated_at DateTime?
  last_login_at  DateTime?
  region         Region?  @relation(fields: [region_id], references: [id])
  region_id      String?
  /// The supervisor who manages this user's field work (relevant for merchandisers).
  /// Drives "my team" scoping for schedules — who a supervisor may plan for.
  supervisor      User?    @relation("SupervisorTeam", fields: [supervisor_id], references: [id], onDelete: SetNull)
  supervisor_id   String?
  team            User[]   @relation("SupervisorTeam")
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  userStores        UserStore[]
  visits            Visit[]
  schedulesAssigned Schedule[] @relation("AssignedSchedules")
  schedulesCreated  Schedule[] @relation("CreatedSchedules")
  dashboards        Dashboard[]
  refreshTokens     RefreshToken[]
  sellOuts          SellOut[]
  productRequests   ProductRequest[]
  promosCreated     Promo[]
  promoPictures     PromoItemPicture[]
  notifications     Notification[]
  priceSurveyAssignments PriceSurveyAssignment[]
  priceSurveySubmissions PriceSurveySubmission[]

  @@index([role_id])
  @@index([is_active])
  @@index([supervisor_id])
  @@map("users")
}

/// A hashed, rotating refresh token backing a single browser/device session.
/// Storing the hash (not the raw token) lets us revoke sessions server-side
/// (logout, password change, deactivation) without invalidating the JWT
/// signature check alone.
model RefreshToken {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

/// A Point of Sale (POS).
model Store {
  id   String @id @default(uuid())
  name String

  // ── General information ──────────────────────────────────────────────────
  /// Retail chain the POS belongs to, e.g. "Marjane", "Carrefour".
  brand          String?
  channel        StoreChannel?
  classification StoreClassification?

  // ── Address ──────────────────────────────────────────────────────────────
  address     String?
  city        String?
  postal_code String?
  region      Region? @relation(fields: [region_id], references: [id])
  region_id   String?

  opening_date DateTime? @db.Date

  // ── Contacts ─────────────────────────────────────────────────────────────
  /// Chef de rayon — runs the specific section the products sit in.
  section_manager_name     String?
  section_manager_phone    String?
  /// Chef de département — runs the wider department.
  department_manager_name  String?
  department_manager_phone String?
  /// Gestionnaire de Stock / Directeur de Site.
  gds_name                 String?
  gds_phone                String?

  // ── Geolocation ──────────────────────────────────────────────────────────
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  /// Optional explicit Google Maps link. When empty the app derives one from lat/lng.
  google_maps_url String?

  is_active Boolean @default(true)
  /// Super Admin curates which POS the general_management role may see.
  visible_to_gm Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  userStores      UserStore[]
  productStores   ProductStore[]
  visits          Visit[]
  schedules       Schedule[]
  sellOuts        SellOut[]
  productRequests ProductRequest[]
  priceSurveyAssignments PriceSurveyAssignment[]
  priceSurveySubmissions PriceSurveySubmission[]

  @@index([visible_to_gm])
  @@index([is_active])
  @@index([city])
  @@index([brand])
  @@map("stores")
}

model UserStore {
  id       String @id @default(uuid())
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id  String
  store    Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id String

  @@map("user_stores")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  sku          String   @unique
  category     String
  is_our_product Boolean @default(false)
  distributeur String
  famille      String
  sous_famille String
  format       String
  /// Owning brand / supplier.
  client       Client?  @relation(fields: [client_id], references: [id], onDelete: SetNull)
  client_id    String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  productStores ProductStore[]
  auditItems    AuditItem[]
  sellOuts      SellOut[]
  promoItems    PromoItem[]
  priceSurveyAssignments PriceSurveyAssignment[]
  priceSurveyItems       PriceSurveyItem[]

  @@index([client_id])
  @@map("products")
}

// Consumer sell-out entry: quantity sold and price for a product at a store.
model SellOut {
  id             String   @id @default(uuid())
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id     String
  store          Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id       String
  quantity       Int
  price          Decimal  @db.Decimal(10, 2)
  created_by     User?    @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_by_id  String?
  created_at     DateTime @default(now())

  @@index([product_id])
  @@index([store_id])
  @@map("sell_outs")
}

// Per-store quantity limit for a product
model ProductStore {
  id           String  @id @default(uuid())
  product      Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id   String
  store        Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id     String
  expected_qty Int     @default(0)

  @@unique([product_id, store_id])
  @@map("product_stores")
}

// A field-submitted request for a custom-sized product: a store, any product
// sub-family (Sous Famille), physical dimensions, and a reference photo.
model ProductRequest {
  id            String   @id @default(uuid())
  store         Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id      String
  sous_famille  String
  width         Decimal  @db.Decimal(10, 2)
  height        Decimal  @db.Decimal(10, 2)
  depth         Decimal  @db.Decimal(10, 2)
  /// Up to 5 reference photos — enforced in CreateProductRequestDto/UpdateProductRequestDto, not the DB.
  image_urls    String[]
  created_by    User?    @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_by_id String?
  created_at    DateTime @default(now())

  @@index([store_id])
  @@map("product_requests")
}

model Visit {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  store         Store       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id      String
  schedule      Schedule?   @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  schedule_id   String?     @unique
  checkin_time  DateTime
  checkin_lat   Decimal?    @db.Decimal(10, 7)
  checkin_lng   Decimal?    @db.Decimal(10, 7)
  checkout_time DateTime?
  checkout_lat  Decimal?    @db.Decimal(10, 7)
  checkout_lng  Decimal?    @db.Decimal(10, 7)
  /// Elapsed seconds between checkin_time and checkout_time, computed server-side
  /// at checkout. Null while the visit is still open.
  duration_seconds Int?
  status           VisitStatus @default(open)

  /// Legacy supervisor spot-check report (title + note + photos) — superseded by
  /// report_cards below. No longer written to; kept so historical visits from
  /// before the multi-card redesign still display correctly.
  report_title  String?
  report_note   String?
  report_photos String[] @default([])

  /// Merchandiser "before/after" shelf photos, bracketing the product audit.
  /// Required before checkout for non-supervisor visits.
  initial_note   String?
  initial_photos String[] @default([])
  final_note     String?
  final_photos   String[] @default([])

  /// Supervisor spot-check report cards (one or more), filled in during the visit
  /// in place of the merchandiser's product audit. At least one is required
  /// before checkout when the visitor is a supervisor.
  report_cards VisitReportCard[]

  auditItems AuditItem[]

  /// Supports the "one open visit per merchandiser" lookup and the resume query.
  @@index([user_id, status])
  @@map("visits")
}

model VisitReportCard {
  id         String               @id @default(uuid())
  visit      Visit                @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  visit_id   String
  category   VisitReportCategory
  note       String?
  photos     String[]
  /// Preserves the order the supervisor entered cards in — submitReport always
  /// replaces the full set, so this can't be inferred from created_at alone.
  position   Int                  @default(0)
  created_at DateTime             @default(now())

  @@index([visit_id])
  @@map("visit_report_cards")
}

model AuditItem {
  id           String          @id @default(uuid())
  visit        Visit           @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  visit_id     String
  product      Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id   String
  qty_found    Int
  expected_qty Int             // snapshot from ProductStore.expected_qty at audit time
  variance     Int             @default(0) // qty_found - expected_qty, computed in service
  status       AuditItemStatus
  photo_url    String?
  notes        String?
  /// Whether this product is currently running an in-store promotion, flagged
  /// by the merchandiser during the audit.
  has_promo    Boolean         @default(false)

  @@unique([visit_id, product_id])
  @@map("audit_items")
}

model Schedule {
  id            String         @id @default(uuid())
  user          User           @relation("AssignedSchedules", fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  store         Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id      String
  created_by    User           @relation("CreatedSchedules", fields: [created_by_id], references: [id])
  created_by_id String
  scheduled_at  DateTime
  notes         String?
  status        ScheduleStatus @default(pending)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  visit Visit?

  @@map("schedules")
}

// ─── Promos ────────────────────────────────────────────────────────────────────

/// A monthly promo campaign: a batch of products at a discounted price. Only
/// one batch is `is_active` at a time — publishing a new one (manually or via
/// Excel import) deactivates whichever batch was active before it, which is
/// what makes the "everyone always sees only the latest promo" behavior work
/// without the read endpoint needing any date logic.
model Promo {
  id            String   @id @default(uuid())
  title         String?
  is_active     Boolean  @default(true)
  created_by    User?    @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  items PromoItem[]

  @@index([is_active])
  @@index([created_at])
  @@map("promos")
}

model PromoItem {
  id             String   @id @default(uuid())
  promo          Promo    @relation(fields: [promo_id], references: [id], onDelete: Cascade)
  promo_id       String
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id     String
  /// Free-text size/volume variant for this promo line, e.g. "33cl", "1L".
  contenance     String
  original_price Decimal  @db.Decimal(10, 2)
  promo_price    Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now())

  pictures PromoItemPicture[]

  @@index([promo_id])
  @@index([product_id])
  @@map("promo_items")
}

/// One field user's proof-of-shelf photo for one promo line. Scoped to
/// (promo_item, user) — a single slot per user, re-uploading replaces it —
/// and visible only to that user and the Super Admin (enforced in the service).
model PromoItemPicture {
  id            String    @id @default(uuid())
  promo_item    PromoItem @relation(fields: [promo_item_id], references: [id], onDelete: Cascade)
  promo_item_id String
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  image_url     String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  @@unique([promo_item_id, user_id])
  @@map("promo_item_pictures")
}

/// A per-user in-app notification (e.g. "new promo published"). Polled from
/// the frontend bell — no push/websocket transport.
model Notification {
  id         String           @id @default(uuid())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  type       NotificationType
  title      String
  body       String?
  /// Frontend route to open when the notification is clicked, e.g. "/promos".
  link       String?
  is_read    Boolean          @default(false)
  metadata   Json?
  created_at DateTime         @default(now())

  @@index([user_id, is_read])
  @@index([created_at])
  @@map("notifications")
}

// ─── Price Surveys (Relevé de Prix) ────────────────────────────────────────────

/// The persistent list of products a given (user, store) pair must survey.
/// Edited only by super_admin/admin via price_surveys.manage. Untouched by
/// "Nouveau relevé de prix" — this is what survives a reset.
model PriceSurveyAssignment {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  store      Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id   String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id String
  created_at DateTime @default(now())

  @@unique([user_id, store_id, product_id])
  @@index([user_id, store_id])
  @@map("price_survey_assignments")
}

/// One "round" of a price survey for a (user, store) pair. `submitted_at: null`
/// is the live in-progress draft — the service ensures at most one exists per
/// (user_id, store_id) at a time. Clicking "Nouveau relevé de prix" stamps
/// `submitted_at` (making this row immutable history) and opens a fresh draft.
model PriceSurveySubmission {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  store        Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  store_id     String
  submitted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  items PriceSurveyItem[]
  notes PriceSurveyNote[]

  @@index([user_id, store_id, submitted_at])
  @@map("price_survey_submissions")
}

/// One product's filled-in line for one submission round. The user's own
/// CL/size is read from Product.format, not duplicated here; the competitor's
/// CL is free text since their product/size may differ from ours.
model PriceSurveyItem {
  id            String                @id @default(uuid())
  submission    PriceSurveySubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  submission_id String
  product       Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id    String

  price_normal Decimal? @db.Decimal(10, 2)
  price_promo  Decimal? @db.Decimal(10, 2)
  etat         String?

  competitor_name        String?
  competitor_cl           String?
  competitor_price_normal Decimal? @db.Decimal(10, 2)
  competitor_price_promo  Decimal? @db.Decimal(10, 2)
  competitor_etat         String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([submission_id, product_id])
  @@index([submission_id])
  @@map("price_survey_items")
}

/// One free-text box for the Synthèse slide: (section × sub_area × side).
/// `section`/`sub_area` are validated against the fixed SYNTHESE_STRUCTURE
/// constant in the price-surveys module rather than DB enums, since the
/// sub-area list differs per section.
model PriceSurveyNote {
  id            String                @id @default(uuid())
  submission    PriceSurveySubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  submission_id String
  section       String
  sub_area      String
  side          PriceSurveyNoteSide
  text          String?
  updated_at    DateTime              @default(now()) @updatedAt

  @@unique([submission_id, section, sub_area, side])
  @@index([submission_id])
  @@map("price_survey_notes")
}

// ─── RBAC ──────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  /// Stable machine name, e.g. "super_admin". Matches the UserRole enum for built-in roles.
  name        String   @unique
  label       String
  description String?
  /// System roles cannot be renamed or deleted, only re-permissioned.
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  users       User[]
  permissions RolePermission[]
  dashboards  Dashboard[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  /// "<resource>.<action>", e.g. "users.create".
  code        String   @unique
  resource    String
  action      String
  description String?
  created_at  DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(uuid())
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  role_id       String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  permission_id String

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

// ─── Clients (brands / suppliers) ──────────────────────────────────────────────

model Client {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contact_name  String?
  contact_email String?
  contact_phone String?
  address       String?
  logo_url      String?
  notes         String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  products      Product[]
  subscriptions Subscription[]

  @@index([is_active])
  @@map("clients")
}

// ─── Subscriptions & plans ─────────────────────────────────────────────────────

model Plan {
  id             String        @id @default(uuid())
  name           String
  code           String        @unique
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  currency       String        @default("MAD")
  billing_period BillingPeriod @default(monthly)
  /// null = unlimited
  max_users      Int?
  max_pos        Int?
  max_products   Int?
  is_active      Boolean       @default(true)
  sort_order     Int           @default(0)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now()) @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid())
  client       Client             @relation(fields: [client_id], references: [id], onDelete: Cascade)
  client_id    String
  plan         Plan               @relation(fields: [plan_id], references: [id])
  plan_id      String
  status       SubscriptionStatus @default(trialing)
  starts_at    DateTime
  ends_at      DateTime?
  cancelled_at DateTime?
  notes        String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @default(now()) @updatedAt

  @@index([client_id])
  @@index([status])
  @@map("subscriptions")
}

// ─── KPIs & dashboards ─────────────────────────────────────────────────────────

model Kpi {
  id          String       @id @default(uuid())
  /// Maps to a metric the reports layer knows how to compute, e.g. "visit_completion_rate".
  code        String       @unique
  name        String
  description String?
  /// Display unit, e.g. "%", "MAD", "visits".
  unit        String?
  target      Decimal?     @db.Decimal(12, 2)
  /// Values below this are rendered as critical.
  warn_below  Decimal?     @db.Decimal(12, 2)
  direction   KpiDirection @default(higher_is_better)
  is_active   Boolean      @default(true)
  sort_order  Int          @default(0)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt

  widgets DashboardWidget[]

  @@map("kpis")
}

model Dashboard {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Scope a dashboard to a role; null = available to everyone.
  role        Role?    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  role_id     String?
  /// Owner, when a user personalises their own dashboard. null = shared/global.
  owner       User?    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  owner_id    String?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  widgets DashboardWidget[]

  @@index([role_id])
  @@index([owner_id])
  @@map("dashboards")
}

model DashboardWidget {
  id           String     @id @default(uuid())
  dashboard    Dashboard  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  dashboard_id String
  /// Set for kpi_card widgets; chart/table widgets may derive data another way.
  kpi          Kpi?       @relation(fields: [kpi_id], references: [id], onDelete: SetNull)
  kpi_id       String?
  type         WidgetType @default(kpi_card)
  title        String
  /// Free-form widget options (filters, series, colours…).
  config       Json?
  /// Grid placement.
  position     Int        @default(0)
  width        Int        @default(1)
  height       Int        @default(1)
  is_visible   Boolean    @default(true)

  @@index([dashboard_id])
  @@map("dashboard_widgets")
}

// ─── Admin audit trail ─────────────────────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(uuid())
  actor_id    String?
  actor_email String
  action      String
  resource    String
  resource_id String?
  metadata    Json?
  created_at  DateTime @default(now())

  @@index([resource, resource_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

/// Runtime-toggleable feature flags (e.g. whether GPS is required to check
/// in/out of a store). Absent key = the flag's registered default applies.
model FeatureFlag {
  id         String   @id @default(uuid())
  key        String   @unique
  enabled    Boolean
  updated_at DateTime @updatedAt

  @@map("feature_flags")
}
