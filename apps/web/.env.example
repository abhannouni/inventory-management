# Copy this file to `.env` (already git-ignored) and fill in your own values.
# Never commit real values — only this template belongs in git.

# Backend base URL used by fetch client.
# For phone testing, use your machine LAN IP or an API devtunnel URL.
VITE_API_URL=http://192.168.0.6:3001/api

# Mapbox public access token (starts with "pk."), used to render POS location
# maps. Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
